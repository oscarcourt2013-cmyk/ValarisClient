# Copy to backend/.env (never commit .env)

PORT=26005
HOST=0.0.0.0

# Optional: public URL advertised in /v1/versions
# PRIME_PUBLIC_URL=http://194.9.172.102:26005

# Groq proxy for /v1/ai/* (server-side only)
# GROQ_API_KEY=gsk_...

# Anonymous stats salt (IP/device hashes). Rotate to invalidate dedupe windows.
# STATS_SALT=change-me

# Dedupe windows (ms) — same hashed identity won't re-count until expiry
# STATS_DOWNLOAD_DEDUPE_MS=3600000
# STATS_LAUNCH_DEDUPE_MS=21600000

# Optional data overrides
# PRIME_DATA_DIR=./data
# PRIME_UPLOAD_DIR=./uploads
