<style>
  .launcher__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
  }

  .launcher__list {
    list-style: none;
    margin-top: 32px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .launcher__list li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 0.95rem;
    color: var(--prime-muted);
  }

  .launcher__list svg {
    flex-shrink: 0;
    margin-top: 3px;
    color: var(--prime-success);
  }

  .launcher__panel {
    padding: 28px;
    box-shadow: var(--shadow-glow);
  }

  .launcher__panel-header {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 24px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--prime-border);
  }

  .launcher__panel-header img {
    filter: drop-shadow(0 0 16px rgba(255, 45, 66, 0.45));
  }

  .launcher__panel-header strong {
    display: block;
    font-size: 1.1rem;
  }

  .launcher__panel-header span {
    font-size: 0.8rem;
    color: var(--prime-muted-2);
  }

  .launcher__panel-rows {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .launcher__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.9rem;
    color: var(--prime-muted);
    gap: 12px;
  }

  .launcher__pill {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--prime-border);
    color: var(--prime-white);
    text-align: right;
    white-space: nowrap;
  }

  .launcher__pill--ok {
    background: rgba(34, 197, 94, 0.12);
    border-color: rgba(34, 197, 94, 0.3);
    color: var(--prime-success);
  }

  .launcher__panel-footer {
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1px solid var(--prime-border);
    text-align: center;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--prime-red-bright);
  }

  @media (max-width: 900px) {
    .launcher__inner {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>
